{
  "name": "jev-kit",
  "version": "0.0.0",
  "description": "Small TypeScript-first Jev client, preflight checks, typed validators, offline fixtures, and a model-neutral classifier CLI.",
  "type": "module",
  "private": true,
  "bin": {
    "classifier": "bin/jev.mjs",
    "clf": "bin/jev.mjs",
    "jev-skill-gap": "bin/jev-skill-gap.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "runners",
    "ROBOT.md",
    "test/fixtures",
    "examples",
    "package.json",
    "templates"
  ],
  "jev": {
    "safe_side_tests": {
      "installer.gate.unreachable.refuses": {
        "surface_type": "command-gate",
        "safe_side": "refuse",
        "test": "gateNetworkUnreachableRefuses"
      },
      "installer.screen.unreachable.passes": {
        "surface_type": "result-screen",
        "safe_side": "pass",
        "test": "screenNetworkUnreachablePasses"
      }
    }
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.18.6"
  },
  "scripts": {
    "prepack": "node scripts/copy-questions.mjs && tsc -p tsconfig.json",
    "prepare": "node scripts/copy-questions.mjs && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  }
}
