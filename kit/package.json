{
  "name": "jev-kit",
  "version": "0.0.0",
  "description": "Small TypeScript-first Jev client, preflights, validators, fake asker, and CLI.",
  "type": "module",
  "private": false,
  "bin": {
    "jev": "bin/jev.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "ROBOT.md",
    "test/fixtures",
    "examples",
    "package.json",
    "templates"
  ],
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.18.6"
  },
  "scripts": {
    "prepack": "node scripts/copy-questions.mjs && tsc -p tsconfig.json",
    "prepare": "node scripts/copy-questions.mjs && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  }
}
