{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jev.local/contracts/decision-contract.schema.json",
  "title": "Classifier Decision Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "question", "state", "surface_type", "safe_side", "budget", "labels", "bar", "host", "consumer"],
  "properties": {
    "family": { "type": "string", "minLength": 1 },
    "question": {
      "type": "object",
      "required": ["type", "instructions", "decision"],
      "properties": {
        "type": { "enum": ["choice", "score", "noul", "rule"] },
        "instructions": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 },
        "options": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "object",
            "required": ["description", "action"],
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "action": { "enum": ["pass", "refuse"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "choice" } }, "required": ["type"] },
          "then": { "required": ["options"] }
        }
      ]
    },
    "state": {
      "type": "object",
      "required": ["fields", "privacy_allowlist", "maximum_state_text_bytes", "raw_transcript_allowed"],
      "properties": {
        "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "privacy_allowlist": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "maximum_state_text_bytes": { "type": "integer", "minimum": 1 },
        "raw_transcript_allowed": { "const": false }
      },
      "additionalProperties": false
    },
    "surface_type": { "enum": ["command-gate", "result-screen", "memory-screen", "advisory"] },
    "safe_side": { "enum": ["pass", "refuse"] },
    "budget": {
      "type": "object",
      "required": ["latency_budget_ms", "daily_call_cap", "cap_reached_action"],
      "properties": {
        "latency_budget_ms": { "type": "integer", "minimum": 1 },
        "daily_call_cap": { "type": "integer", "minimum": 0 },
        "cap_reached_action": { "enum": ["pass", "refuse"] },
        "max_live_calls_per_run": { "type": "integer", "minimum": 0 },
        "max_input_tokens_per_run": { "type": "integer", "minimum": 0 },
        "estimated_input_spend_usd": { "type": "number", "minimum": 0 },
        "no_retry": { "const": true }
      },
      "additionalProperties": false
    },
    "labels": { "type": "object", "required": ["source"], "properties": { "source": { "type": "string", "minLength": 1 } }, "additionalProperties": true },
    "bar": { "type": "object", "required": ["source"], "properties": { "source": { "type": "string", "minLength": 1 } }, "additionalProperties": true },
    "host": { "type": "string", "minLength": 1 },
    "consumer": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "surface_type": { "enum": ["result-screen", "memory-screen", "advisory"] } }, "required": ["surface_type"] },
      "then": { "properties": { "safe_side": { "const": "pass" }, "budget": { "properties": { "cap_reached_action": { "const": "pass" } } } }
    },
    {
      "if": { "properties": { "budget": { "properties": { "cap_reached_action": { "const": "refuse" } }, "required": ["cap_reached_action"] } }, "required": ["budget"] },
      "then": { "properties": { "surface_type": { "const": "command-gate" } } }
    }
  ]
}
