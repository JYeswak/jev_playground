#!/usr/bin/env bash
# jev pre-commit: two lanes, in order of severity. Resolve every implementation beside the hook
# path Git chose (never from the repo root — a worktree may run this from elsewhere).
#
# LANE 1 — staged-deletion survival (house implementation, byte-identical to foundry's).
#   Refuses a path-limited commit that silently DROPPED a staged deletion whose file is still on
#   disk. Proof: foundation/gates.d/60-staged-deletion-lane.sh, **2 trigger + 6 satisfying** witnesses
#   — corrected 2026-09-18 from "1 trigger + 5 satisfying", the SECOND place that stale count lived
#   (pane 3, 85d75a0 found it in GATES.md; 71183c0 found this copy). Re-derive from the script, which
#   is the authority; a count duplicated into a comment rots in every copy independently.
#
# LANE 2 — autofix, in --check mode ONLY (report-only, exit 1 when the staged set is not clean).
#   loop-kit/autofix-precommit.sh can MUTATE files, and this is the one wiring decision worth
#   arguing: three agents share this worktree, and the fixer does NOT re-stage what it rewrites.
#   Mutating during a commit would therefore land the UNFIXED bytes and leave a modified file
#   behind — turning every commit into a dirty tree and failing the end-of-shift clean-tree lane.
#   So the hook FLAGS and the human/agent fixes explicitly:
#       ~/Developer/foundry/loop-kit/autofix-precommit.sh --staged --repo .
#       git add -- <the files it rewrote>          # explicit paths; dcg denies git add -A here
#   The fixer stays one command away; it never runs behind your back.
#
# Both lanes are skipped with a named reason rather than silently when their implementation is
# missing — an unreachable lane must not read like a pass.

set -euo pipefail

_hookdir=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)
_repo=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# ── lane 1: staged-deletion survival ────────────────────────────────────────────────────────────
_impl="$_hookdir/pre-commit-staged-deletion-survives.sh"
if [ ! -x "$_impl" ]; then
  printf 'STAGED_DELETION_REFUSED reason=impl-missing path=%s\n' "$_impl" >&2
  exit 1
fi
"$_impl" "$@"

# ── lane 2: autofix cleanliness (report-only) ───────────────────────────────────────────────────
_autofix="${LOOP_KIT:-$HOME/Developer/foundry/loop-kit}/autofix-precommit.sh"
if [ ! -x "$_autofix" ]; then
  # FAILS CLOSED, with a deliberate escape. This branch used to `exit 0`: a MISSING checker silently
  # permitted the commit, while lane 1 above refuses when ITS implementation is absent, and
  # foundation/gates.sh treats an empty scan set as an ERROR rather than a pass. Same repo, opposite
  # doctrine, and the inconsistency stayed invisible because every machine running these hooks has
  # loop-kit installed, so the open branch never fired here.
  #
  # Adopted from bicameral (docs/demos/upstream-repro/bicameral-20260918.md): its degraded path falls
  # back to pattern rules rather than letting work through unjudged. A checker that vanishes must not
  # read as a checker that passed.
  #
  # The escape is explicit and has to be typed: JEV_ALLOW_MISSING_AUTOFIX=1 names the risk at the
  # moment it is taken, which `exit 0` never did.
  if [ "${JEV_ALLOW_MISSING_AUTOFIX:-}" = "1" ]; then
    printf 'AUTOFIX_LANE_SKIPPED reason=impl-missing path=%s (allowed by JEV_ALLOW_MISSING_AUTOFIX=1)\n' "$_autofix" >&2
    exit 0
  fi
  printf 'AUTOFIX_REFUSED reason=impl-missing path=%s\n' "$_autofix" >&2
  printf '  install loop-kit, set LOOP_KIT=<path>, or take the risk deliberately:\n' >&2
  printf '  JEV_ALLOW_MISSING_AUTOFIX=1 git commit --only <paths> -F <msg-file>\n' >&2
  exit 1
fi

if ! "$_autofix" --check --staged --repo "$_repo"; then
  printf '\nAUTOFIX_REFUSED: the staged set is not format-clean. Fix it explicitly:\n' >&2
  printf '  %s --staged --repo %s\n' "$_autofix" "$_repo" >&2
  printf '  git add -- <the rewritten paths>   # explicit paths; dcg denies git add -A here\n' >&2
  exit 1
fi
