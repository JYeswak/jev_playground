#!/usr/bin/env bash
# Portable stamp wrapper. Resolve the implementation beside the hook path Git chose.

set -euo pipefail

_hookdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
_impl="$_hookdir/pre-commit-staged-deletion-survives.sh"
if [ ! -x "$_impl" ]; then
  printf 'STAGED_DELETION_REFUSED reason=impl-missing path=%s\n' "$_impl" >&2
  exit 1
fi

exec "$_impl" "$@"
